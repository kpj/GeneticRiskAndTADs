from snakemake.utils import validate

# setup
if "experiment" not in config:
    raise ValueError(
        "No experiment specified! Please provide an experiment name via '--config experiment=<name>' "
        "or run via './run.sh <experiment>'."
    )


configfile: "config/base.yaml"
configfile: f"config/experiments/{config['experiment']}.yaml"


validate(config, "../config/config.schema.yaml")

RESULTS_DIR = f"results/{config['experiment']}"


report: "report/workflow.rst"


include: "rules/common.smk"


import sys
import re
from pathlib import Path

# Add scripts directory to sys.path to import callers parser
sys.path.insert(0, str(Path(workflow.basedir) / "scripts"))
from callers import expand_caller_configs, resolve_consensus_caller_configs


localrules:
    all,
    gather_input_information,
    aggregate_tads,
    provide_input_files,
    include_tad_relations,
    compute_enrichments,
    create_figures,
    create_report,


actual_caller_configs = expand_caller_configs(config["caller_configs"])

# Resolve configured majority voting schemes
majority_votes_config = config.get("majority_votes", {})
resolved_majority_votes = {}
for name, vote_cfg in majority_votes_config.items():
    selector = vote_cfg.get("caller_configs", "all")
    resolved_callers = resolve_consensus_caller_configs(selector, actual_caller_configs)
    if not resolved_callers:
        continue
    resolved_majority_votes[name] = {
        **vote_cfg,
        "resolved_caller_configs": resolved_callers,
    }

consensus_configs = list(resolved_majority_votes.keys())
all_caller_configs = consensus_configs + actual_caller_configs

consensus_id_pattern = (
    "(?:" + "|".join(re.escape(k) for k in consensus_configs) + ")"
    if consensus_configs
    else r"[a-zA-Z0-9_.-]+"
)

wildcard_constraints:
    caller_config=r"[a-zA-Z0-9_.-]+",
    tad_parameter=r"[a-zA-Z0-9_.-]+",
    consensus_id=consensus_id_pattern,


ruleorder: snp_majority_vote > aggregate_tads
ruleorder: snp_majority_vote > include_tad_relations


hic_sources_raw = config["samples"].keys()
hic_sources = generate_data_source_list(
    config["samples"], config.get("mcool_resolutions", {})
)


# master target rule
rule all:
    """Target rule specifying final publication figures, enrichments, and statistics."""
    input:
        RESULTS_DIR + "/results/final_enr.csv.gz",
        RESULTS_DIR + "/results/database_statistics/",
        RESULTS_DIR + "/post_analysis/",
        RESULTS_DIR + "/publication_figures/main/",
        RESULTS_DIR + "/publication_figures/tad_plots_multidataset/",
        RESULTS_DIR + "/publication_figures/tad_plots_multiwindowsize/",


# modular rule includes
include: "rules/hic.smk"
include: "rules/tads.smk"
include: "rules/databases.smk"
include: "rules/enrichment.smk"
include: "rules/figures.smk"
